APP_NAME=Intelligent File Deduplication & Storage Optimization System
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=mysql+pymysql://dedup_user:dedup_password@mysql:3307/file_deduplication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
UPLOAD_DIR=/app/uploads
MAX_FILE_SIZE_MB=1024
CHUNK_SIZE_BYTES=1048576
ALLOWED_EXTENSIONS=pdf,txt,csv,jpg,jpeg,png,gif,webp,doc,docx,xls,xlsx,ppt,pptx,zip
